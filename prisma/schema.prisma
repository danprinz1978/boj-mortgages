// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Define your models here
model User {
  id    Int    @id @default(autoincrement()) // Primary key
  name  String
  email String @unique

  @@map("user")  // This maps the 'User' model to the 'users' table in the database
}